generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model test1 {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model test2 {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
}

model Recipe {
  id           Int           @id @default(autoincrement())
  name         String
  createdAt    DateTime      @default(now())
  combo        String        @unique
  calorie      Int?
  protein      Float?        // タンパク質 (g)
  fat          Float?        // 脂質 (g)
  carbs        Float?        // 炭水化物 (g)
  consumptions Consumption[]
}

model User {
  id             Int           @id @default(autoincrement())
  name           String
  email          String        @unique
  hashedPassword String? 
  targetCal      Int
  targetProtein  Float?        // 目標タンパク質 (g/日)
  targetFat      Float?        // 目標脂質 (g/日)
  targetCarbs    Float?        // 目標炭水化物 (g/日)
  dislikedFoods  String[]      // 苦手な食べ物（配列）
  allergens      String[]      // アレルギー食品（配列）
  createdAt      DateTime      @default(now())
  consumptions   Consumption[]
}

model Consumption {
  id         Int      @id @default(autoincrement())
  userId     Int
  recipeId   Int
  quantity   Int
  consumedAt DateTime @default(now())
  recipe     Recipe   @relation(fields: [recipeId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
